---
import { SITE, COUNTS, watch } from '../../lib/site';
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="stage stage-hero" id="stage-hero" aria-hidden="true">
    <img class="hero-poster" src="/img/globe-poster.webp" alt="" width="1200" height="1200" fetchpriority="low" decoding="async" />
  </div>
  <div class="hero-copy">
    <p class="hero-eyebrow eyebrow"><span class="n">IND</span><span class="rule"></span>Passport no. 177 / 197</p>
    <h1 id="hero-title" class="hero-title">
      <span class="count-wrap"><span class="count" id="hero-count" data-final={COUNTS.hisCount}>{COUNTS.hisCount}</span></span>
      <span class="of"><span class="ln"><span>of {COUNTS.total} countries,</span></span><span class="ln"><span>on an Indian passport</span></span></span>
    </h1>
    <script is:inline>(function(){if(document.documentElement.classList.contains('motion')){var c=document.getElementById('hero-count');c.textContent='0';c.style.fontStretch='75%'}})();</script>
    <p class="hero-lede">Navankur Chaudhary has spent nine years filming the world in Hindi: {COUNTS.videos} videos so far, and {COUNTS.toGo} countries still to go.</p>
    <div class="hero-actions">
      <a class="btn btn-gold" href="#globe" data-magnetic><span>Explore his globe <span class="arr">↓</span></span></a>
      <a class="btn btn-ghost" href={SITE.subscribe} target="_blank" rel="noopener" data-magnetic><span>Subscribe on YouTube</span></a>
    </div>
    <p class="now"><span class="pulse" aria-hidden="true"></span>Now filming in {SITE.now.place}. <a href={watch(SITE.now.video)} target="_blank" rel="noopener">Watch the latest episode</a></p>
    <p class="live-note" id="live-note" hidden>The sunlight on this Earth is live, for <span id="live-time">now</span> your time.</p>
  </div>
  <div class="mrz" aria-hidden="true" data-mrz>
    <span data-mrz-line>P&lt;INDCHAUDHARY&lt;&lt;NAVANKUR&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;</span>
    <span data-mrz-line>YATRIDOCTOR&lt;&lt;177&lt;197&lt;&lt;IND&lt;&lt;2017&lt;2026&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;</span>
  </div>
  <a class="scroll-cue" href="#board" aria-label="Scroll to the numbers"><span class="mono">Scroll</span><i aria-hidden="true"></i></a>
</section>
